# Replace implementations here without changing capability-level scripts.

ATLAS_TERMINAL="${ATLAS_TERMINAL:-kitty}"
ATLAS_EDITOR="${ATLAS_EDITOR:-nvim}"
ATLAS_BROWSER="${ATLAS_BROWSER:-firefox}"
ATLAS_FILE_MANAGER="${ATLAS_FILE_MANAGER:-nautilus}"
ATLAS_LAUNCHER="${ATLAS_LAUNCHER:-rofi}"
ATLAS_STATUSBAR="${ATLAS_STATUSBAR:-waybar}"
ATLAS_NOTIFICATIONS="${ATLAS_NOTIFICATIONS:-swaync}"
ATLAS_CLIPBOARD_STORE="${ATLAS_CLIPBOARD_STORE:-cliphist}"
ATLAS_WALLPAPER_DAEMON="${ATLAS_WALLPAPER_DAEMON:-awww}"
ATLAS_LOCKER="${ATLAS_LOCKER:-hyprlock}"
ATLAS_IDLE_DAEMON="${ATLAS_IDLE_DAEMON:-hypridle}"
