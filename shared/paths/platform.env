# ATLAS shared path constants.

ATLAS_ROOT="${ATLAS_ROOT:-$HOME/.config/hypr}"
ATLAS_AUTOMATION="$ATLAS_ROOT/automation"
ATLAS_DESKTOP="$ATLAS_ROOT/desktop"
ATLAS_DEVELOPMENT="$ATLAS_ROOT/development"
ATLAS_SYSTEM="$ATLAS_ROOT/system"
ATLAS_SHARED="$ATLAS_ROOT/shared"
ATLAS_PACKAGES="$ATLAS_ROOT/packages"
ATLAS_INSTALL="$ATLAS_ROOT/install"
ATLAS_PROFILES="$ATLAS_ROOT/profiles"
ATLAS_DOCS="$ATLAS_ROOT/docs"
ATLAS_ASSETS="$ATLAS_ROOT/assets"
ATLAS_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/atlas"
ATLAS_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/atlas"
ATLAS_LOG_DIR="$ATLAS_STATE/logs"
